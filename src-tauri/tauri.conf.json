{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cdesign Desktop",
  "version": "0.1.0",
  "identifier": "com.cdesign.viewer",
  "build": {
    "beforeDevCommand": { "script": "bun desktop/stage.ts", "wait": true },
    "beforeBuildCommand": "bun desktop/stage.ts",
    "frontendDist": "../desktop/assets"
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/cdesign-bun"],
    "resources": { "runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
